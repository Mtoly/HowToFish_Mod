+    if "{" in text or "}" in text:
+        continue
+    visible = re.sub(r"\{[^{}]*\}", "", text)
+    if not re.search(r"[A-Za-z]{3,}", visible):
+        continue
+    if any(item in visible for item in allowed):
+        continue
+    if text.startswith(("type ", "field ", "method ")):
+        continue
+    residual.append(text)
