+			Entity = record.Entity,
+			Transform = record.Transform,
+			AimPoint = point.Position,
+			Bone = point.Bone,
+			Distance = distance,
+			Angle = angle,
+			ScreenPosition = point.ScreenPosition,
+			ScreenDistance = point.ScreenDistance,
