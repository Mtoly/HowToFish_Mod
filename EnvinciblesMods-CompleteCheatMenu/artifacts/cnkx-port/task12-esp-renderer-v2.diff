+    extents=(1.0, 2.0, 1.0),
+    screen=(1920.0, 1080.0),
+    vertical_fov=90.0,
+)
+assert offscreen is not None
+assert all(math.isfinite(value) for value in offscreen)
+assert offscreen[0] > 1920.0
+
+# 7. 生产实现必须具备 Repaint 门控、八角点投影、稳定回退框和目标高亮。
+renderer = (
