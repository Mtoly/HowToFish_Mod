+	}
+
+	internal static IReadOnlyList<EntityRecord> Items
+	{
+		get
+		{
+			RefreshItems();
+			return _items;
+		}
+	}
+
+	internal static IReadOnlyList<EntityRecord> Containers
+	{
+		get
+		{
+			RefreshContainers();
+			return _containers;
+		}
